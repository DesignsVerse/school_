// This is your Prisma schema file.
// We are using SQLite for local development to ensure it runs out-of-the-box.
// IMPORTANT: Before deploying to Vercel, change `provider` to "postgresql" and use your Vercel KV/Postgres URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id          String   @id @default(cuid())
  section     String   // e.g., "hero", "about", "contact"
  key         String   // e.g., "title", "description", "phone"
  value       String   // The actual text content
  type        String   @default("text") // text, textarea, image, link
  label       String?  // Human readable label
  description String?  // Instruction for the admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([section, key])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  content     String
  noticeDate  DateTime
  published   Boolean  @default(true)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FacultyMember {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  role        String
  phone       String?
  imageSrc    String
  about       String
  description String?
  highlights  String[]
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SchoolEvent {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  category      String
  categoryColor String   @default("bg-blue-500")
  location      String
  time          String
  description   String
  image         String
  published     Boolean  @default(true)
  eventDate     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdmissionEnquiry {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  dob              DateTime?
  gender           String
  classApplyingFor String
  mobileNumber     String
  email            String
  address          String
  fatherName       String
  fatherMobile     String
  motherName       String
  motherMobile     String
  enquirySource    String?
  scholarNo        String?
  guardianName     String?
  guardianContact  String?
  boarding         String?
  interactionDate  DateTime?
  remarks          String?
  undertaking      Boolean  @default(false)
  documentNames    String[]
  photoNames       String[]
  status           String   @default("new")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
